#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="__NIXWALL_SELF_DIR__"
if [[ "$SELF_DIR" == "__NIXWALL_SELF_DIR__" ]]; then
	SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/nixwall-installer" && pwd)"
fi

. "$SELF_DIR/lib/common.sh"
. "$SELF_DIR/functions/confirm.sh"
. "$SELF_DIR/functions/run_disko.sh"
. "$SELF_DIR/functions/install.sh"

main() {
	set_defaults
	parse_args "$@"

	if [ "$ONLINE" -eq 0 ]; then
		export NIX_CONFIG=$'substituters =
connect-timeout = 1
download-attempts = 1'
	fi

	require_root "$@"

	header "Planning…"
	confirm_or_exit
	run_disko
	do_install
}

main "$@"
